# DRL Trading Agent — Environment Configuration
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Yahoo Finance Proxy (for regions where Yahoo Finance is blocked)
# YAHOO_FINANCE_PROXY=http://proxy.example.com:8080

# API Tokens (optional, for future data sources)
# YAHOO_FINANCE_API_TOKEN=your_token_here
# ALPHA_VANTAGE_API_TOKEN=your_token_here

# Database Path Override (optional)
# DATABASE_PATH=./data/drl_trading.db

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO
